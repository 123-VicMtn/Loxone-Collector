{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:decompte": "vite --config pages/decompte/vite.config.ts",
    "build:decompte": "vue-tsc -p pages/decompte/tsconfig.json --noEmit && vite build --config pages/decompte/vite.config.ts",
    "preview:decompte": "vite preview --config pages/decompte/vite.config.ts",
    "dev:admin": "vite --config pages/admin/vite.config.ts",
    "build:admin": "vue-tsc -p pages/admin/tsconfig.json --noEmit && vite build --config pages/admin/vite.config.ts",
    "preview:admin": "vite preview --config pages/admin/vite.config.ts",
    "build": "npm run build:decompte && npm run build:admin"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "chart.js": "^4.5.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
