# Copie vers .env (à la racine, jamais versionné) : lu par docker compose
# pour compose.yaml. Les secrets de l'application sont dans backend/.env.

# Domaine servi par Caddy (enregistrements A et AAAA vers le VPS avant le
# premier démarrage). Essai sur le Mac : localhost.
DOMAIN=loxone-collector.123-soleil.ch

# Contact Let's Encrypt (expiration de certificat, incidents).
ACME_EMAIL=
