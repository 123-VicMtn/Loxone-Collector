# Copie ce fichier vers .env (jamais versionné) et renseigne les vrais
# identifiants. Utilise idéalement un utilisateur Loxone Config dédié,
# en lecture seule ("Visualisation" uniquement), plutôt que le compte admin.

# Signe les cookies de session (auth, voir auth.py) -- obligatoire, Flask
# refuse de démarrer sans. Générer une valeur :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

LOXONE_MAISON_USER=
LOXONE_MAISON_PASSWORD=

# LOXONE_CHALET_USER=
# LOXONE_CHALET_PASSWORD=

# Utilisateur dédié pour tester l'accès EXTERNE (voir config.external.yaml.example) :
# LOXONE_EXTERNE_USER=
# LOXONE_EXTERNE_PASSWORD=

# Démo dashboard (config.demo.yaml, données synthétiques) — valeurs
# bidons, jamais utilisées pour une vraie connexion :
LOXONE_DEMO_USER=demo
LOXONE_DEMO_PASSWORD=demo
