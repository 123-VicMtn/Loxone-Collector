[Unit]
Description=Loxone Collector - poller + API backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adapte User/WorkingDirectory au chemin réel de déploiement. Le venv
# Python reste à la racine du repo (backend/ n'a pas son propre .venv,
# voir CLAUDE.md "Nettoyage de la structure du backend") -- seuls le code
# applicatif, la config et les données ont été déplacés sous backend/.
User=pi
WorkingDirectory=/home/pi/loxone-collector/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/loxone-collector/.venv/bin/python /home/pi/loxone-collector/backend/app.py
Restart=on-failure
RestartSec=5

# Durcissement basique (optionnel mais recommandé). Commente ces lignes si
# elles posent problème.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/pi/loxone-collector/backend/data

[Install]
WantedBy=multi-user.target
